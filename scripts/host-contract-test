#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
host_root="${OCP_HOST_CHECKOUT:-$repo_root/.host-contract}"
exec "$host_root/backend/.venv/bin/python" "$repo_root/scripts/host_contract_test.py" \
  "$host_root" "$repo_root/dist/analysis-areas-1.4.0.ocp"
