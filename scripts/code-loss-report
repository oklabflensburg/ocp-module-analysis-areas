#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
host_root="${OCP_HOST_CHECKOUT:-$repo_root/.host-contract}"
source="$host_root/backend/app/modules/analysis_areas"
target="$repo_root/backend/src/ocp_module_analysis_areas"

printf 'Host backend file -> standalone backend file\n'
unclassified=0
while IFS= read -r file; do
  relative="${file#$source/}"
  if [[ -f "$target/$relative" ]]; then
    state=present
  else
    case "$relative" in
      application/legacy_queries.py)
        state='REPLACED: application/queries.py + public SDK ports'
        ;;
      application/legacy_sync.py)
        state='REPLACED: application/osm_sync.py + public OSM/event/cache contracts'
        ;;
      integrations/legacy.py)
        state='REPLACED: public SDK ports; no private adapter'
        ;;
      *)
        state=UNCLASSIFIED
        unclassified=1
        ;;
    esac
  fi
  printf '%s -> %s [%s]\n' "$file" "$target/$relative" "$state"
done < <(find "$source" -type f -name '*.py' | sort)

printf '\nHistorical workflow -> standalone owner/status\n'
printf '%s\n' \
  'backend/app/cli/sync_analysis_areas.py -> application/osm_sync.py; automatic event trigger active' \
  'backend/app/cli/sync_wikidata.py -> application/wikidata.py; scheduled job and public service active' \
  'backend/app/cli/set_area_wikidata.py -> public Wikidata maintenance service; generic CLI convenience absent' \
  'backend/app/services/wikidata_enrichment.py -> domain/application/integrations/wikidata.py' \
  'backend/app/cli/postprocess_osm.py -> osm.postprocessing-completed@1 subscriber; polygon relation blocked on UUID mapping'

exit "$unclassified"
