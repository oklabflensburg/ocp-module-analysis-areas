#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
host_root="${OCP_HOST_CHECKOUT:-$repo_root/.host-contract}"
contract="$repo_root/.github/ocp-host-contract.json"
repository="$(python -c 'import json,sys; print(json.load(open(sys.argv[1]))["repository"])' "$contract")"
commit="$(python -c 'import json,sys; print(json.load(open(sys.argv[1]))["commit"])' "$contract")"

if [[ ! -d "$host_root/.git" ]]; then
  git clone --filter=blob:none "$repository" "$host_root"
fi
git -C "$host_root" fetch origin "$commit"
git -C "$host_root" checkout --detach "$commit"
(
  cd "$host_root/backend"
  uv sync --frozen --extra dev
)
(
  cd "$host_root/frontend"
  corepack pnpm install --frozen-lockfile
)
